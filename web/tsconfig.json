{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    // lib/phone.js and lib/arabic.js are authored as JavaScript on purpose —
    // tools/schema-check/verify.mjs imports those exact files and asserts they
    // agree with the SQL. checkJs means their JSDoc types are enforced here
    // just as strictly as a .ts file would be.
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.js", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // EXCLUDED BECAUSE IT IMPORTS A FILE THAT IS NOT IN GIT.
    //
    // lib/queries.preview.ts reads web/preview-data.json, which
    // tools/preview/dump.mjs generates on a developer's machine and .gitignore
    // deliberately keeps out of the repository — it is output, not source.
    //
    // The consequence was invisible locally and fatal in production: the file
    // exists here, so `next build` passed on this machine and failed on Vercel
    // with "Cannot find module '../preview-data.json'", taking the whole deploy
    // with it. Nothing in the shipped site imports this module; only
    // `npm run preview:on` uses it, by copying it over queries.ts — and at that
    // point it is queries.ts, which is included, and the dump is there.
    "lib/queries.preview.ts"
  ]
}
