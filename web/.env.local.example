# انسخ الملف ده باسم .env.local وحط فيه بيانات مشروعك على Supabase.
# الملف ده اللي بيتشيّر في git — .env.local لأ.
#
# من لوحة Supabase: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# المفتاح العام (anon / publishable). ده بيتحط في كود المتصفح، وده طبيعي:
# مالوش صلاحيات من نفسه، والـ RLS هو البوابة.
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-key-here

# رابط الموقع النهائي — لازم يبقى مضبوط عشان روابط السايت ماب ومعاينة الواتساب
# تطلع صح. محلياً سيبه زي ما هو.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ⚠ ممنوع نهائياً تحط الـ service_role key هنا أو في أي مكان في المشروع.
#   أي مفتاح اسمه NEXT_PUBLIC_ بيتشحن للمتصفح.

# ---------------------------------------------------------------- العيادة ----
# مشروع Supabase خاص بالعيادة لوحدها — بيانات المرضى في قاعدة بيانات مستقلة
# مفيهاش أي حاجة من المحل.
#
# سيبهم فاضيين ← العيادة بتشتغل جوّه مشروع المحل، في schema منفصل اسمه clinic.
# املاهم        ← بيانات المرضى بتتنقل لمشروعها لوحدها.
#
# المشروع ده بيتعمل من supabase/SETUP-CLINIC-ONLY.sql — مش من ALL-IN-ONE.
# الخطوات كاملة في docs/العيادة.md
NEXT_PUBLIC_CLINIC_SUPABASE_URL=
NEXT_PUBLIC_CLINIC_SUPABASE_ANON_KEY=
